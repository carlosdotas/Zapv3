# Configuração do servidor (a porta atual é definida por --port, não por PORT)
PORT=3000
NODE_ENV=development
APP_BUILD_ID=

# Banco de dados (MySQL via Prisma). Caracteres especiais na senha devem ser URL-encoded (@ = %40)
DATABASE_URL="mysql://USUARIO:SENHA@HOST:3306/BANCO"

# Servidor externo de imagens (PHP)
IMAGE_SERVER_URL=
IMAGE_SERVER_PASSWORD=

# Chave Google Maps para as rotas de proxy do servidor
GOOGLE_MAPS_API_KEY=

# Configuração legada: não consumida pelo código atual
GEMINI_API_KEY=
